generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  EDITOR
}

enum RequestStatus {
  NEW
  CONTACTED
  APPOINTMENT
  CLOSED
  ARCHIVED
}

model User {
  id           String     @id @default(cuid())
  name         String
  email        String     @unique
  passwordHash String
  role         UserRole   @default(EDITOR)
  active       Boolean    @default(true)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  auditLogs    AuditLog[]
}

model ConsultationRequest {
  id            String        @id @default(cuid())
  fullName      String
  phone         String
  requestType   String
  preferredTime String?
  message       String?
  source        String        @default("website")
  status        RequestStatus @default(NEW)
  notes         String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@index([status, createdAt])
  @@index([phone])
}

model Service {
  id          String   @id @default(cuid())
  slug        String   @unique
  title       String
  summary     String
  description String
  icon        String   @default("heart")
  order       Int      @default(0)
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([active, order])
}

model Faq {
  id        String   @id @default(cuid())
  question  String
  answer    String
  order     Int      @default(0)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([active, order])
}

model ContentEntry {
  id        String   @id @default(cuid())
  key       String   @unique
  label     String
  value     String   @db.Text
  group     String   @default("general")
  updatedAt DateTime @updatedAt

  @@index([group])
}

model SiteSetting {
  id               Int      @id @default(1)
  centerName       String   @default("مرکز بازتوانی سپیدار")
  phone            String   @default("021-12345678")
  mobile           String   @default("0912-1234567")
  email            String   @default("info@sepidarcenter.ir")
  address          String   @default("تهران، آدرس مرکز پس از تماس اعلام می‌شود")
  workingHours     String   @default("همه‌روزه، ساعت ۸ تا ۲۲")
  emergencyMessage String   @default("این وب‌سایت جایگزین خدمات اورژانسی نیست. در شرایط فوری با ۱۱۵ تماس بگیرید.")
  updatedAt        DateTime @updatedAt
}

model AuditLog {
  id        String   @id @default(cuid())
  action    String
  entity    String
  entityId  String?
  summary   String
  createdAt DateTime @default(now())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([createdAt])
}
